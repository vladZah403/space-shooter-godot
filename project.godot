; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Space Shooter"
config/description="Вертикальный космический шутер: Godot-версия игры Space Shooter"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

D="*res://scripts/core/data.gd"
G="*res://scripts/core/gfx.gd"
FX="*res://scripts/core/fx.gd"
Bus="*res://scripts/game/bus.gd"
M="*res://scripts/game/store.gd"
A="*res://scripts/game/audio.gd"
Haptic="*res://scripts/game/haptic.gd"
Main="*res://scripts/game/main.gd"
Game="*res://scripts/game/game.gd"
E="*res://scripts/game/enemies.gd"
B="*res://scripts/game/bosses.gd"
Foes="*res://scripts/game/foes.gd"
Sectors="*res://scripts/game/sectors.gd"
Skills="*res://scripts/game/skills.gd"
Comp="*res://scripts/game/companion.gd"
RunMap="*res://scripts/game/map.gd"
Events="*res://scripts/game/events.gd"
Scenes="*res://scripts/game/scenes.gd"
Intro="*res://scripts/game/intro.gd"
Bg="*res://scripts/game/bg.gd"
Post="*res://scripts/game/post.gd"
Hud="*res://scripts/game/hud.gd"
Ui="*res://scripts/ui/ui.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.023, 0.039, 0.122, 1)
