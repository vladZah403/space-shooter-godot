extends Node2D
## Замер цены примитивов Ctx (запуск с окном): --path . res://tools/check/bench_ctx.tscn
func _ready() -> void:
	var ctx := Ctx.new(get_canvas_item())
	ctx.font = Kit.font(800)
	await get_tree().process_frame
	var N := 2000
	var t := Time.get_ticks_usec()
	for i in N: U.col("#ff4d6d")
	_p("U.col", t, N)
	ctx.begin()
	t = Time.get_ticks_usec()
	for i in N:
		ctx.fill = Color(0.1, 0.1, 0.2, 0.6)
		ctx.begin_path(); ctx.round_rect(10, 10, 44, 44, 14); ctx.fill_path()
	_p("round_rect+fill", t, N)
	t = Time.get_ticks_usec()
	for i in N:
		ctx.begin_path(); ctx.round_rect(10, 10, 44, 44, 14)
	_p("round_rect only", t, N)
	var pts: PackedVector2Array = ctx._subpaths[0] if not ctx._subpaths.is_empty() else ctx._cur
	print("points ", pts.size())
	t = Time.get_ticks_usec()
	for i in N: Geometry2D.triangulate_polygon(pts)
	_p("triangulate", t, N)
	ctx.begin()
	var idx := Geometry2D.triangulate_polygon(pts)
	var cols := PackedColorArray(); cols.resize(pts.size()); cols.fill(Color.WHITE)
	t = Time.get_ticks_usec()
	for i in N: RenderingServer.canvas_item_add_triangle_array(ctx._item(), idx, pts, cols)
	_p("add_triangle_array", t, N)
	ctx.begin()
	t = Time.get_ticks_usec()
	for i in N: RenderingServer.canvas_item_add_polygon(ctx._item(), pts, PackedColorArray([Color.WHITE]))
	_p("add_polygon", t, N)
	ctx.begin()
	t = Time.get_ticks_usec()
	for i in N:
		ctx.begin_path(); ctx.round_rect(10, 10, 44, 44, 14); ctx.fill_path(); ctx.stroke_path()
	_p("round_rect+fill+stroke", t, N)
	ctx.begin()
	t = Time.get_ticks_usec()
	for i in N: ctx.fill_text("12,345", 100, 100, 24, 1, 4, Color(0, 0, 0, 0.75))
	_p("fill_text outline", t, N)
	ctx.begin()
	t = Time.get_ticks_usec()
	for i in N: ctx.fill_text("WAVE 3", 100, 100, 11, 1, 0)
	_p("fill_text", t, N)
	ctx.begin()
	var tex := G.soft("#ff4d6d", 32)
	t = Time.get_ticks_usec()
	for i in N: ctx.draw_tex(tex, 10, 10, 26, 26)
	_p("draw_tex", t, N)
	ctx.begin()
	t = Time.get_ticks_usec()
	for i in N: G.soft("#ff4d6d", 32)
	_p("G.soft lookup", t, N)
	ctx.begin()
	t = Time.get_ticks_usec()
	for i in N:
		ctx.additive = (i % 2) == 0
		ctx.draw_tex(tex, 10, 10, 26, 26)
	_p("draw_tex additive toggle", t, N)
	ctx.begin()
	t = Time.get_ticks_usec()
	for i in N: ctx.fill_rect(1, 1, 5, 20)
	_p("fill_rect", t, N)
	ctx.begin()
	t = Time.get_ticks_usec()
	for i in N: Lang.t("ВОЛНА %d")
	_p("Lang.t", t, N)
	t = Time.get_ticks_usec()
	for i in N: U.fmt(18357)
	_p("U.fmt", t, N)
	get_tree().quit()

func _p(name: String, t0: int, n: int) -> void:
	print("%-26s %.2f мкс" % [name, (Time.get_ticks_usec() - t0) / float(n)])
